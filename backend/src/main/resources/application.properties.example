spring.datasource.url=jdbc:postgresql://localhost:5432/sophub
spring.datasource.username=postgres
spring.datasource.password=DEIN_PASSWORT
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true

# JWT: beliebiger langer Zufallsstring (mind. 32 Zeichen), jeder waehlt seinen eigenen
jwt.secret=DEIN_JWT_SECRET_MINDESTENS_32_ZEICHEN_LANG
jwt.expiration=86400000

spring.servlet.multipart.max-file-size=50MB
spring.servlet.multipart.max-request-size=50MB

# Gmail SMTP: https://myaccount.google.com/apppasswords (App-Passwort, nicht das normale Google-Passwort)
spring.mail.host=smtp.gmail.com
spring.mail.port=587
spring.mail.username=DEINE_GMAIL_ADRESSE
spring.mail.password=DEIN_APP_PASSWORT
spring.mail.properties.mail.smtp.auth=true
spring.mail.properties.mail.smtp.starttls.enable=true
app.mail.from=DEINE_GMAIL_ADRESSE

# KI:connect NRW (OpenAI-kompatibel, kostenlos ueber die Hochschule)
# API-Key erstellen in KI:connect -> "API-Schluesselverwaltung"
kiconnect.api.url=https://chat.kiconnect.nrw/api/v1
kiconnect.api.key=DEIN_KICONNECT_API_KEY
# Modellname aus der eigenen KI:connect-Freigabe (z.B. qwen3.5-397b-a17b_stud, glm-4.7_stud)
kiconnect.model=DEIN_KICONNECT_MODELL